{
  "name": "openclaw-nutty",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform, user-controlled memory for AI conversations",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm run build && pnpm -r --if-present test",
    "check": "pnpm run build && pnpm run typecheck && pnpm -r --if-present test"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
