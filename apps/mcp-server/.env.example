NUTTY_HOST=127.0.0.1
NUTTY_PORT=3000
NUTTY_ALLOWED_HOSTS=localhost,127.0.0.1
NUTTY_PERSONAL_TOKEN=
NUTTY_PRINCIPAL_ID=personal
NUTTY_CONFIRMATION_SECRET=
NUTTY_DESTINATION_ID=feishu-default

FEISHU_TRANSPORT=lark-cli
FEISHU_APP_TOKEN=
FEISHU_TABLE_ID=
FEISHU_WEB_BASE_URL=https://feishu.cn/base

# Local lark-cli transport (default). Run `lark-cli auth login` first.
FEISHU_LARK_CLI_BINARY=lark-cli
FEISHU_LARK_CLI_IDENTITY=user
FEISHU_LARK_CLI_TIMEOUT_MS=30000

# Direct OpenAPI transport. Set FEISHU_TRANSPORT=openapi to use these.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_API_BASE_URL=https://open.feishu.cn/open-apis
